# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows scripts must have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source code, web assets, and documentation
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.in text eol=lf

# Binary files: models, media, archives (no line ending transformation)
*.onnx binary
*.pth binary
*.pt binary
*.bin binary
*.mp4 binary
*.avi binary
*.mov binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
*.tar.gz binary

# These files are checked against a manifest using their original bytes.
codebase/demo/** -text !eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
codebase/models/detector/** -text !eol
codebase/outputs/demo-completion-20261116/** -text !eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
